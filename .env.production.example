# Copy to .env.production on the server. Keep the actual file out of Git.
# Production uses only this configuration, not the local-demo .env.
# Match the existing bloodbank-app-1 / bloodbank-db-1 project on this server.
COMPOSE_PROJECT_NAME=bloodbank

# Built locally by default. Set an existing image tag for --no-build,
# or a registry image tag for --pull (for example ghcr.io/OWNER/bloodbank:TAG).
APP_IMAGE=bloodbank-app

# LAN address of the VM running Docker. Nginx runs in a separate Proxmox LXC
# at 192.168.1.82 and forwards requests to http://192.168.1.135:3001.
APP_BIND_IP=192.168.1.135
APP_PORT=3001

# Stable database volume name. Keep it unchanged between deployments.
# Default volume from the existing regular Compose stack. Verify its actual
# name with docker inspect before deploying; see deploy/README.md.
POSTGRES_VOLUME_NAME=bloodbank_bloodbank_data

# Reuse the existing database password when keeping the current volume.
# For NEW secrets, generate independent values: openssl rand -hex 32
# Single-quote values containing $ or # to keep them literal in Compose.
POSTGRES_PASSWORD=
JWT_SECRET=

# Creates this administrator only when the username does not already exist.
# JWT_SECRET must be at least 32 characters; ADMIN_PASSWORD at least 8.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
