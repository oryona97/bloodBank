# Copy to .env.production on the server. Keep the actual file out of Git.
# Production uses only this configuration, not the local-demo .env.
COMPOSE_PROJECT_NAME=bloodbank-prod

# Built locally by default. Set an existing image tag for --no-build,
# or a registry image tag for --pull (for example ghcr.io/OWNER/bloodbank:TAG).
APP_IMAGE=bloodbank:production

# Existing user-defined Docker network attached to the Nginx container.
PROXY_NETWORK=proxy

# Stable database volume name. Keep it unchanged between deployments.
# For an existing installation, see deploy/README.md before choosing a volume.
POSTGRES_VOLUME_NAME=bloodbank-prod-data

# Generate independent secrets, for example with: openssl rand -hex 32
# Single-quote values containing $ or # to keep them literal in Compose.
POSTGRES_PASSWORD=
JWT_SECRET=

# Creates this administrator only when the username does not already exist.
# JWT_SECRET must be at least 32 characters; ADMIN_PASSWORD at least 8.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
