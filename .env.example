# Copy to .env and supply your local PostgreSQL credentials.
# Docker Compose works without this file using the defaults below.
APP_PORT=3001
POSTGRES_PASSWORD=local_dev_password
DATABASE_URL=postgresql://bloodbank:local_dev_password@127.0.0.1:5432/bloodbank
TEST_DATABASE_URL=postgresql://bloodbank:local_dev_password@127.0.0.1:5432/bloodbank_test
PORT=3001
HOST=127.0.0.1
