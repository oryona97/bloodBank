# Copy to .env and supply your local PostgreSQL credentials.
DATABASE_URL=postgresql://bloodbank:local_dev_password@127.0.0.1:5432/bloodbank
TEST_DATABASE_URL=postgresql://bloodbank:local_dev_password@127.0.0.1:5432/bloodbank_test
PORT=3001
HOST=127.0.0.1
# Optional owner connection for migrations/bootstrap; runtime should use a restricted role.
# MIGRATION_DATABASE_URL=postgresql://owner:password@127.0.0.1:5432/bloodbank
# COOKIE_SECURE=true
# Supply ADMIN_USERNAME, ADMIN_DISPLAY_NAME and ADMIN_PASSWORD only while running npm run db:admin.
# Supply RUNTIME_DB_USER and RUNTIME_DB_PASSWORD only while running npm run db:runtime-role.
